@model FinanceApp.Models.Expense

<div class="container">
    <h2>Create Expense</h2>
    <form asp-action="Create" method="post">
        <div>
            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <input asp-for="Description" class="form-control" required />
            </div>
            <div class="mb-3">
                <label asp-for="Amount" class="form-label"></label>
                <input asp-for="Amount" type="number" step="0.01" min="0.01" class="form-control" required />
            </div>
            <div class="mb-3">
                <label asp-for="Category" class="form-label"></label>
                <input asp-for="Category" class="form-control" required />
            </div>
            <div class="mb-3">
                <label asp-for="Date" class="form-label"></label>
                <input asp-for="Date" type="date" class="form-control" required />
            </div>
        </div>
        <button type="submit" class="btn btn-primary">Add Expense</button>
    </form>
</div>
